Dá para fazer com argc e argv, também usando o makefile, isso é algo interessante para ser estudado e talvez implementado nos proximos projetos:

ex.: 
int	main(int argc, char **argv)
{
	int		fd;
	char	*line;

	if (argc != 2)
		return (1);
	fd = open(argv[1], O_RDONLY | O_APPEND);
	line = get_next_line(fd);
	while (line)
	{
		printf("%s\n", line);
		free(line);
		line = get_next_line(fd);
	}
	close(fd);
}
